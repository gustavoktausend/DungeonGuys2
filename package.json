{
  "name": "dungeonguys2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run sim:build && npm run sim:version && tsc --noEmit && vite build && npm run sw:emit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:pwa": "playwright test",
    "typecheck:sim": "tsc -p packages/sim/tsconfig.json --noEmit",
    "typecheck:protocol": "tsc -p packages/protocol/tsconfig.json --noEmit",
    "typecheck:pwa": "tsc -p tests/pwa/tsconfig.json --noEmit",
    "sim:build": "vite build --config packages/sim/vite.config.ts",
    "sim:version": "node tools/sim-version/emit.mjs",
    "sim:version:verify": "node tools/sim-version/verify.mjs",
    "sw:emit": "node tools/sw/emit.mjs",
    "golden:rebaseline": "node tools/golden/rebaseline.mjs",
    "assets:validate": "node tools/assets/validate.mjs",
    "assets:selftest": "node tools/assets/validate.mjs tools/assets/fixtures/good",
    "assets:refusal": "node tools/assets/refusal-check.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@stdlib/math-base-special-atan2": "^0.3.1",
    "@stdlib/math-base-special-cos": "^0.3.1",
    "@stdlib/math-base-special-sin": "^0.3.1",
    "@types/node": "^24.13.3",
    "@vitest/browser-playwright": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "playwright": "1.62.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
