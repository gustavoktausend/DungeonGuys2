node_modules/
dist/
*.local
.DS_Store
.claude/worktrees/

# Vitest browser mode dumps a screenshot and an attachment for every failing
# test. The cross-engine gate is red ON PURPOSE until plan 01-12, so these are
# regenerated on every run and must never be committed.
tests/__screenshots__/
.vitest-attachments/

# The @dg2/sim lib bundle plus its sibling sim-version.json. Already covered by
# the bare `dist/` rule above, but spelled out because this artifact is the
# INPUT of SIM_VERSION (D-07): it is derived from source on every build, and
# committing it would let a stale hash outlive the code it describes.
packages/sim/dist
