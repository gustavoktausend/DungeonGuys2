{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The same move tests/pwa/tsconfig.json makes, and for the same two files'
    // worth of reason: e2e-helpers.ts opens an http.Server, imports
    // apps/server/src/signaling and reaches for node:crypto, so it needs Node's
    // types — and the ROOT must keep `types: ["vite/client"]` untouched
    // (tools/README.md §4), because putting "node" there would hand `process`,
    // `Buffer` and `__dirname` to every file under src/. The client is DOM-only
    // and must stay unable to reach for them by accident.
    //
    // THIS DIRECTORY IS SPLIT DOWN THE MIDDLE, and that is the whole reason the
    // root's `exclude` names two files instead of the directory. tests/net/
    // helpers.ts is PURE — it drives the in-process transport of tests/lobby.ts
    // and friends, needs no Node types, and belongs in the root program with
    // the tests that import it. Only the two Playwright-side files are carved
    // out. Excluding the directory would have quietly taken helpers.ts out of
    // every program that typechecks it.
    "types": ["node"],

    // DOM is still required: the bodies of page.evaluate() run in the browser.
    // ES2023 for the array helpers the specs use.
    "lib": ["ES2023", "DOM"]
  },

  // Both fields must be restated. `include` and `exclude` are inherited through
  // `extends`, and the root carries an `exclude` that names these very files —
  // inheriting it here would typecheck nothing and pass by vacuity.
  "include": ["./room.spec.ts", "./e2e-helpers.ts", "../../playwright.config.ts"],
  "exclude": []
}
