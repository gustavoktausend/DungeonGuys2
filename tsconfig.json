{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],

    // `paths` without `baseUrl`: TS 6.0 rejects `baseUrl` outright (TS5101,
    // removed in TS 7), and since TS 4.1 a non-relative mapping resolves
    // relative to this tsconfig. The mapping exists so `tsc` sees the package
    // as source; runtime resolution comes from the npm workspace symlink.
    "paths": {
      "@dg2/sim": ["./packages/sim/src/index.ts"],
      "@dg2/protocol": ["./packages/protocol/src/index.ts"]
    }
  },
  "include": ["src", "tests", "packages", "vite.config.ts", "eslint.config.js"],

  // tests/pwa/ is the one corner of the repository that needs Node types
  // (helpers.ts opens an http.Server the offline spec has to close). It is
  // excluded here so that `types` above STAYS `["vite/client"]` — the client
  // is DOM-only and tools/README.md §4 says not to touch that. Those files are
  // covered by tests/pwa/tsconfig.json, run as `npm run typecheck:pwa`.
  //
  // The server test files are here for the same reason and no other: they drive
  // apps/server, which opens a database, reads process.env and binds a socket,
  // so they need Node types too. They are covered by apps/server/tsconfig.json,
  // run as `npm run typecheck:server`, whose `include` names them one by one.
  // Note that `apps` was never in the `include` above, so the server SOURCE was
  // already outside this program — only its tests had to be carved out, since
  // `tests` is included wholesale.
  //
  // The list grew by three in phase 3 (server-rooms, server-signaling, turn),
  // and each one is named in BOTH places in the same commit. Excluding here
  // without including there is the failure that leaves a test typechecked by
  // nothing.
  //
  // `turn` breaks the naming pattern of its neighbours on purpose: it is not
  // named `server-turn` because the module it tests is the one piece of this
  // pair the client half of phase 3 also reasons about, and a name that said
  // "server" would suggest otherwise. It is here for the ordinary reason — it
  // imports node:crypto.
  "exclude": [
    "tests/pwa",
    "tests/server-migrate.test.ts",
    "tests/server-health.test.ts",
    "tests/server-rooms.test.ts",
    "tests/server-signaling.test.ts",
    "tests/turn.test.ts"
  ]
}
