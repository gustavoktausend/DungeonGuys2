{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],

    // `paths` without `baseUrl`: TS 6.0 rejects `baseUrl` outright (TS5101,
    // removed in TS 7), and since TS 4.1 a non-relative mapping resolves
    // relative to this tsconfig. The mapping exists so `tsc` sees the package
    // as source; runtime resolution comes from the npm workspace symlink.
    "paths": {
      "@dg2/sim": ["./packages/sim/src/index.ts"]
    }
  },
  "include": ["src", "tests", "packages", "vite.config.ts", "eslint.config.js"]
}
